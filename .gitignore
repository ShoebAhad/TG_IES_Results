traj_ref/
checkpoints/
il_cache/

# Python bytecode
__pycache__/
*.pyc

# Scratch / exploratory outputs, not part of any reported result
_batch_size_sweep_scratch/
scratch_verify2/

# Redundant zipped bundles of logs+benchmarks already present under logs/ and results/
tgies_densenet121_3seed_2026-09-02.zip
tgies_vit_tiny_cifar_2026-09-03.zip

# Personal/third-party reference PDFs, not this project's own source
arXiv 2502.07547.pdf
Theory Guided IES (6).pdf

# Tool-internal config
.claude/

# Paper source: kept local-only, never pushed to this public repo.
# paper_iclr2026/ is an anonymous double-blind ICLR submission in progress;
# publishing it here (under an identified GitHub account) would risk breaking
# anonymity / dual-submission norms. paper/ is an earlier draft of the same
# work. EXPERIMENT_LOG.md/NEXT_STEPS.md also reference other venues' review
# process and are kept private for the same reason.
paper/
paper_iclr2026/
EXPERIMENT_LOG.md
NEXT_STEPS.md
README.md

# Driver scripts and run logs: kept local-only (working infra, not artifacts).
*.sh
*.log
logs/
